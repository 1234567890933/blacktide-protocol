; Blacktide Protocol — offline 3D tactical Battle Royale
; Engine: Godot 4.3 (MIT) — Android arm64-v8a only
config_version=5

[application]

config/name="Blacktide Protocol"
config/description="Offline tactical Battle Royale. 60 operators, one island, shrinking quarantine."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.02, 0.03, 0.04, 1)

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
InputHub="*res://scripts/autoload/input_hub.gd"
StoryDirector="*res://scripts/autoload/story_director.gd"
AudioDirector="*res://scripts/autoload/audio_director.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="actors"
3d_physics/layer_3="loot"
3d_physics/layer_4="hitbox"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=18.0

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/default_filters/anisotropic_filtering_level=2
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.05, 0.07, 0.09, 1)
limits/spatial_indexer/threaded_cull_minimum_instances=500
